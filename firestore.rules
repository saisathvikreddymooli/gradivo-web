rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function authPhone() {
      return signedIn() && 'phone_number' in request.auth.token
        ? request.auth.token.phone_number
        : "";
    }

    // The stored phone number must be empty or match the verified
    // phone number on the Firebase Auth account. It can never be
    // set to someone else's number.
    function validProfilePhone() {
      return !('phone' in request.resource.data)
        || request.resource.data.phone == ""
        || request.resource.data.phone == authPhone();
    }

    function conv() {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isConvParticipant() {
      return signedIn() && request.auth.uid in conv().participants;
    }

    function otherUid() {
      return conv().participants[0] == request.auth.uid
        ? conv().participants[1]
        : conv().participants[0];
    }

    function pairBlocked() {
      return exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + otherUid()))
        || exists(/databases/$(database)/documents/blocks/$(otherUid() + '_' + request.auth.uid));
    }

    function isGroupMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function groupType(groupId) {
      return groupData(groupId).get('type', 'public');
    }

    function isGroupArrayMember(groupId) {
      return signedIn() && request.auth.uid in groupData(groupId).get('members', []);
    }

    function isGroupMemberAny(groupId) {
      return isGroupMember(groupId) || isGroupArrayMember(groupId);
    }

    function isGroupAdmin(groupId) {
      return signedIn()
        && (request.auth.uid in groupData(groupId).get('admins', [])
          || request.auth.uid == groupData(groupId).get('createdBy', ''));
    }

    // A group and its member records are committed together. getAfter lets
    // the member-record rules verify the creator against that batch's group.
    function isGroupAdminAfter(groupId) {
      let data = getAfter(/databases/$(database)/documents/groups/$(groupId)).data;
      return signedIn()
        && (request.auth.uid in data.get('admins', [])
          || request.auth.uid == data.get('createdBy', ''));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId)
        && request.resource.data.keys().hasAll(['name', 'isVerifiedSenior'])
        && request.resource.data.isVerifiedSenior == false
        && validProfilePhone();
      allow update: if isUser(userId)
        // Older profiles may not have this field yet. Treat an absent value
        // as false while still preventing clients from changing verification.
        && request.resource.data.get('isVerifiedSenior', false)
          == resource.data.get('isVerifiedSenior', false)
        && validProfilePhone();
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isConvParticipant();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isConvParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConvParticipant();
        allow create: if isConvParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 4000
          && !pairBlocked();
        allow update: if isConvParticipant()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text == resource.data.text;
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (request.resource.data.createdBy == request.auth.uid
          || (request.resource.data.createdBy == 'system'
            && (groupId in ['india-students', 'first-year', 'cybersecurity', 'ai-ml', 'machine-learning', 'web-dev', 'cloud', 'programming', 'hackathons', 'project-partners', 'internships', 'startups', 'cse', 'ise', 'ece']
              || groupId.matches('state-[a-z0-9-]+'))))
        && request.resource.data.admins is list
        && request.resource.data.members is list
        && (request.resource.data.createdBy == 'system'
          || (request.auth.uid in request.resource.data.admins
            && request.auth.uid in request.resource.data.members))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.type in ['public', 'private'];
      allow update: if signedIn() && (
        (isGroupAdmin(groupId)
          && request.resource.data.get('createdBy', resource.data.get('createdBy', ''))
            == resource.data.get('createdBy', ''))
        || (isGroupMemberAny(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount'])
          && ((request.auth.uid in resource.data.get('members', [])
              && !(request.auth.uid in request.resource.data.get('members', []))
              && request.resource.data.get('memberCount', 0) == resource.data.get('memberCount', 0) - 1)
            || (!(request.auth.uid in resource.data.get('members', []))
              && request.auth.uid in request.resource.data.get('members', [])
              && request.resource.data.get('memberCount', 0) == resource.data.get('memberCount', 0) + 1)))
      );
      allow delete: if false;

      match /members/{userId} {
        allow read: if signedIn();
        allow create: if isUser(userId) || isGroupAdminAfter(groupId);
        allow delete: if isUser(userId) || isGroupAdmin(groupId);
        allow update: if isGroupAdmin(groupId);
      }

      match /messages/{messageId} {
        allow read: if signedIn()
          && (groupType(groupId) == 'public' || isGroupMemberAny(groupId));
        allow create: if isGroupMemberAny(groupId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 4000;
        allow update, delete: if false;
      }
    }

    match /groupMembers/{memberId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && (request.resource.data.userId == request.auth.uid
          || isGroupAdminAfter(request.resource.data.groupId));
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid
          || isGroupAdmin(resource.data.groupId));
      allow update: if false;
    }

    match /projectRequests/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.projectName is string
        && request.resource.data.projectName.size() > 0
        && request.resource.data.projectName.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.technologies is list
        && request.resource.data.requiredSkills is list
        && (request.resource.data.teamSize is int
          || request.resource.data.teamSize is float)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.teamSize >= 1
        && request.resource.data.teamSize <= 100
        && request.resource.data.college is string
        && request.resource.data.country is string
        && request.resource.data.state is string
        && request.resource.data.deadline is string
        && request.resource.data.status == 'open';
      allow update: if signedIn()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }

    // Curated real-world opportunities (internships, hackathons).
    // Public listings: anyone can read. Writes happen only through the
    // Firebase console or Admin SDK — never from the app client.
    match /opportunities/{opportunityId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn() && resource.data.reportedBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reportedUser is string
        && request.resource.data.reason is string;
      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn()
        && (resource.data.blockedBy == request.auth.uid
          || resource.data.blockedUser == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.blockedBy == request.auth.uid
        && request.resource.data.blockedUser is string
        && request.resource.data.blockedUser != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUser;
      allow delete: if signedIn() && resource.data.blockedBy == request.auth.uid;
      allow update: if false;
    }
  }
}
